{
  "entities": {
    "clients": {
      "title": "Clients",
      "description": "Registered clients in the portal",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "cpfCnpj": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "cpfCnpj", "email"]
    },
    "boletos": {
      "title": "Boletos",
      "description": "Boletos and PIX billing documents",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "dueDate": { "type": "string" },
        "status": { "type": "string" },
        "lineDigitable": { "type": "string" },
        "pixKey": { "type": "string" },
        "barcode": { "type": "string" },
        "paidAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientId", "amount", "dueDate", "status"]
    },
    "nfes": {
      "title": "Nota Fiscal Eletrônica",
      "description": "Issued service invoices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "number": { "type": "string" },
        "issueDate": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "serviceDescription": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "clientId", "number", "amount", "status"]
    },
    "tickets": {
      "title": "Support Tickets",
      "description": "Customer support requests and messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "clientId", "title", "status"]
    },
    "notifications": {
      "title": "Notifications",
      "description": "In-app and push notification logs",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "boletoId": { "type": "string" },
        "clientId": { "type": "string" },
        "read": { "type": "boolean" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "title", "body", "type", "read", "timestamp"]
    },
    "expenses": {
      "title": "Expenses",
      "description": "Monthly operational expenses, bills and supplier payments",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "dueDate": { "type": "string" },
        "paymentDate": { "type": "string" },
        "status": { "type": "string" },
        "month": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "description", "category", "amount", "dueDate", "status", "month"]
    },
    "monthly_balances": {
      "title": "Monthly Account Balances",
      "description": "Registered bank account balances per month for cash flow projection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "month": { "type": "string" },
        "bankAccount": { "type": "string" },
        "initialBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "updatedAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "month", "bankAccount", "initialBalance"]
    },
    "inventory": {
      "title": "Inventory Items",
      "description": "Stock of hardware devices, trackers, sensors and accessories",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "model": { "type": "string" },
        "category": { "type": "string" },
        "brand": { "type": "string" },
        "sku": { "type": "string" },
        "quantity": { "type": "number" },
        "minQuantity": { "type": "number" },
        "unitCost": { "type": "number" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "name", "model", "category", "brand", "quantity", "minQuantity", "status"]
    },
    "stock_movements": {
      "title": "Stock Movements",
      "description": "Audit history of inventory entries and exits/deductions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "itemName": { "type": "string" },
        "type": { "type": "string" },
        "quantity": { "type": "number" },
        "previousQuantity": { "type": "number" },
        "newQuantity": { "type": "number" },
        "reason": { "type": "string" },
        "clientId": { "type": "string" },
        "clientName": { "type": "string" },
        "technician": { "type": "string" },
        "notes": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "itemId", "itemName", "type", "quantity", "previousQuantity", "newQuantity", "reason", "timestamp"]
    }
  },
  "firestore": {
    "/clients/{clientId}": { "schema": "clients", "description": "Client accounts" },
    "/boletos/{boletoId}": { "schema": "boletos", "description": "Boletos and bills" },
    "/nfes/{nfeId}": { "schema": "nfes", "description": "Invoices" },
    "/tickets/{ticketId}": { "schema": "tickets", "description": "Support tickets" },
    "/notifications/{notifId}": { "schema": "notifications", "description": "System notifications" },
    "/expenses/{expenseId}": { "schema": "expenses", "description": "Operational expenses" },
    "/monthly_balances/{balanceId}": { "schema": "monthly_balances", "description": "Monthly account balances" },
    "/inventory/{itemId}": { "schema": "inventory", "description": "Hardware and devices inventory items" },
    "/stock_movements/{movementId}": { "schema": "stock_movements", "description": "Stock movements history and audit logs" }
  }
}
